$grp LL_MissionDescription : "{4A2582FF7C761EAE}Prefabs/Map/LL_MissionDescription.et" {
 MissionIntroduction {
  coords 4917.363 322.781 5594.006
  m_sTitle "Описание события"
  m_sTextData "<h>Battle of Bamut</h>"\
  "<color=180,188,193>Эпизод 2</color>"\
  "<gap/>"\
  "Май 1996 года. Чечня, Ачхой-Мартановский район."\
  "<gap/>"\
  "Федеральные войска заняли Аршты. Отряды ЧРИ удерживают <link=Bamut>Бамут</link>."\
  "<gap/>"\
  "Федеральные войска готовят последний штурм <link=Bamut>Бамута</link>."
  m_iOrder 0
 }
 Conditions {
  coords 4919.363 322.781 5594.006
  m_sTitle "Общие условности"
  m_sTextData "<h>Условности для всех</h>"\
  "— Запрещено снимать или переодевать форму. Смена головных уборов на союзные разрешена."\
  "— Запрещено использовать вражескую форму, бронежилеты, разгрузки и головные уборы. Рюкзаки использовать можно."\
  "— Не используйте игровой чат. О проблеме сообщите администратору другим способом."\
  "<hr/><h>Время</h>"\
  "— Подготовка к эпизоду — 10 минут."\
  "— Активная фаза эпизода — 60 минут."
  m_iOrder 1
 }
 Conditions_CHRI {
  coords 4921.363 322.781 5594.006
  m_sTitle "Условности обороны, ЧРИ"
  m_sTextData "<h>Условия победы в эпизоде</h>"\
  "— К концу эпизода <link=Bamut>Бамут</link> удерживает ЧРИ. Триггер неперезахватываемый."\
  "— В живых осталось пять или менее игроков федеральных войск."\
  "— Сторона ЧРИ создала четырёхкратное преимущество над стороной федеральных войск."\
  "— С условиями захвата <link=Bamut>Бамута</link> можно ознакомиться во вкладке условий миссии."
  m_iOrder 2
 }
 Conditions_RF90 {
  coords 4923.363 322.781 5594.006
  m_sTitle "Условности атаки, федеральные войска"
  m_sTextData "<h>Условия победы в эпизоде</h>"\
  "— Захвачен <link=Bamut>Бамут</link>. Триггер неперезахватываемый."\
  "— В живых осталось три или менее игроков ЧРИ."\
  "— Сторона федеральных войск создала четырёхкратное преимущество над стороной ЧРИ."\
  "— С условиями захвата <link=Bamut>Бамута</link> можно ознакомиться во вкладке условий миссии."
  m_iOrder 3
 }
 Help {
  coords 4925.363 322.781 5594.006
  m_sTitle "Помощь во время игры"
  m_sTextData "Если во время игры вам потребуется техническая помощь, зажмите кнопку Y — это уведомит администратора. Также можно обратиться к администратору в Discord или в личном чате Telegram. Администратор всегда на связи во время игры."
  m_iOrder 4
 }
}
